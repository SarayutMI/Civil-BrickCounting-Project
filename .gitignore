.DS_Store

# React client — deps are reproducible via `npm install` inside client/, unlike the
# root project (this repo's existing convention commits root node_modules directly)
client/node_modules/

# Runtime-generated data — grows unbounded, not source
snapshots/
ftp-uploads/
backups/

# Real device credentials (WiFi/camera/FTP passwords) — see config.example.h
esp32-cam-bridge/config.h

# Login accounts + passwords for scripts/seed-users.js — never commit
seed-users.local.json
.env

# Claude Code personal settings
.claude/settings.local.json

# PlatformIO build output (esp32-cam-bridge/platformio.ini)
esp32-cam-bridge/.pio/
